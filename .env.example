# Application Metadata
APP_NAME="Enterprise AI Support Agent"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Active LLM Provider: "aurai" or "openrouter"
LLM_PROVIDER="aurai"

# Aurai Configuration (Primary Provider)
AURAI_API_KEY="api_gAAAAAB_your_aurai_key_here"
AURAI_BASE_URL="https://api-pilot-sandbox.aurai.solutions/v1"
AURAI_MODEL="Aurai-3.0"

# OpenRouter Configuration (Secondary / Backup Provider)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="qwen/qwen-2.5-72b-instruct"

# Security & Authentication (JWT)
JWT_SECRET_KEY="change_this_to_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Qdrant Cloud Vector Database
QDRANT_URL="https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY="your_qdrant_cloud_api_key"
QDRANT_COLLECTION_NAME="enterprise_knowledge"

# Cloud Embeddings via OpenRouter
EMBEDDING_PROVIDER="openrouter"
EMBEDDING_MODEL="openai/text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Supabase Relational Database (PostgreSQL & PostgREST)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your_supabase_service_role_or_anon_key"

# Tavily External Search Configuration (Phase 4)
TAVILY_API_KEY="tvly-your-tavily-api-key-here"
TAVILY_SEARCH_DEPTH="basic"
TAVILY_TIMEOUT_SECONDS=10
TAVILY_MAX_RESULTS=5

# Phase 5: Productionization & Reliability
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
METRICS_ENABLED=true
